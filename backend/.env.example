# Copy this file to backend/.env and fill in the values.
# Port the Express + Socket.IO server listens on.
PORT=3000

# MongoDB connection string (MongoDB Atlas or local mongod).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/basicvcs
MONGODB_URI=

# Secret used to sign JWTs. Use a long random string.
JWT_SECRET_KEY=

# Origins allowed to call the API from the browser (comma-separated).
# In development these are the Vite dev server URLs.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# AWS credentials used by config/aws-config.js (S3 object storage).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=basicvcsbucket
